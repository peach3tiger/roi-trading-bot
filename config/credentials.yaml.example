# Sao chép file này thành credentials.yaml và điền giá trị thật.
# credentials.yaml PHẢI nằm trong .gitignore — không bao giờ commit.
# Cách nạp khuyến nghị vẫn là qua .env (xem .env.example) — file này chỉ
# tồn tại cho các thành phần đọc cấu hình dạng YAML thay vì biến môi trường.
# Không bao giờ hardcode giá trị thật vào settings.yaml hay bất kỳ file
# nào được commit (xem CLAUDE.md bất biến #6).

bybit:
  api_key: "YOUR_API_KEY_HERE"
  api_secret: "YOUR_API_SECRET_HERE"

telegram:
  bot_token: "YOUR_TELEGRAM_BOT_TOKEN_HERE"
  chat_id: "YOUR_TELEGRAM_CHAT_ID_HERE"
