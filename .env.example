# Sao chép file này thành .env và điền giá trị thật.
# .env PHẢI nằm trong .gitignore — không bao giờ commit khoá thật, và
# không bao giờ log giá trị này kể cả một phần (xem CLAUDE.md bất biến #6).

# Sàn thật đọc từ config/settings.yaml: exchange.name — tên biến ở đây
# không buộc vào một sàn cụ thể. Thiếu EXCHANGE_API_KEY/EXCHANGE_API_SECRET
# làm ops/health_check.py::exchange_authenticated FAIL rõ ràng, nêu đúng
# tên biến còn thiếu — không có fallback nào khác.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
